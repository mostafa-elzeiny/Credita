{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user-specific metadata and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth UID." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role for RBAC." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of profile creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of last update." }
      },
      "required": ["uid", "email", "role"]
    },
    "FinancialStatement": {
      "title": "Financial Statement",
      "description": "Represents a company's financial data extracted from documents.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the statement." },
        "ownerUid": { "type": "string", "description": "UID of the user who owns this statement." },
        "companyName": { "type": "string", "description": "Name of the company." },
        "fiscalYear": { "type": "integer", "description": "The year the statement covers." },
        "data": { "type": "object", "description": "The raw extracted financial data (JSON)." },
        "analysis": { "type": "object", "description": "The AI-generated analysis results." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation." }
      },
      "required": ["id", "ownerUid", "companyName", "fiscalYear", "data"]
    },
    "SupportMessage": {
      "title": "Support Message",
      "description": "Messages sent via the contact support form.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the message." },
        "name": { "type": "string", "description": "Name of the sender." },
        "email": { "type": "string", "format": "email", "description": "Email of the sender." },
        "message": { "type": "string", "description": "The message content." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of message creation." }
      },
      "required": ["id", "name", "email", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/statements/{statementId}": {
      "schema": "FinancialStatement",
      "description": "Financial statement documents."
    },
    "/support_messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Support messages collection."
    }
  }
}
